---
import AppWindow from '@/components/mock/AppWindow.astro';
import NoticeCard from '@/components/mock/NoticeCard.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import { LANDING } from '@/content/landing';
import { SITE } from '@/content/site';

const { hero, highlights } = LANDING;
---

<!-- Pulled up under the header (transparent at the top), so the glow reaches the top edge. -->
<section aria-labelledby="hero-title" class="relative isolate -mt-16 overflow-hidden pt-16">
  <div class="backdrop-brand absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="backdrop-grid absolute inset-0 -z-10" aria-hidden="true"></div>

  <Container class="pt-16 pb-4 sm:pt-24 lg:pt-28">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p
        style="--d: 0"
        class="enter inline-flex items-center gap-2 rounded-full bg-surface/70 px-3.5 py-1.5 text-[0.8125rem] font-medium text-ink-2 ring-glass backdrop-blur"
      >
        <Icon name="sparkle" class="size-4 text-brand" />
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="type-display mt-6">
        <span style="--d: 1" class="enter block">
          {hero.titleStart}
        </span>
        <span style="--d: 2" class="enter text-gradient block pb-1">
          {hero.titleAccent}
        </span>
      </h1>
      <p style="--d: 3" class="enter type-lead mt-6 max-w-2xl text-muted">
        {hero.lead}
      </p>
      <div style="--d: 4" class="enter mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <Button href="#demo" size="lg">
          {hero.primary}
          <Icon name="arrowRight" class="size-4.5" />
        </Button>
        <Button href={SITE.links.signUp} variant="secondary" size="lg">
          {hero.secondary}
        </Button>
      </div>
      <p style="--d: 5" class="enter mt-4 flex items-center gap-2 text-sm text-subtle">
        {hero.note}
        <span aria-hidden="true">·</span>
        <a
          href={SITE.links.github}
          class="inline-flex items-center gap-1.5 font-medium text-ink-2 underline-offset-4 hover:text-ink hover:underline"
        >
          <Icon name="github" class="size-4" />
          {hero.source}
        </a>
      </p>
    </div>

    <!-- `scene` + data-animate: the drawn walkthrough starts once the window is in view. -->
    <div
      style="--d: 5"
      class="enter tilt-stage scene relative mx-auto mt-16 max-w-5xl sm:mt-20"
      data-animate
    >
      <div
        class="absolute -inset-x-8 -top-8 -bottom-12 -z-10 rounded-[3rem] bg-gradient-to-b from-brand/15 to-transparent blur-2xl"
        aria-hidden="true"
      ></div>
      <div class="tilt">
        <AppWindow />
      </div>
      <div class="scene-notice absolute top-48 -right-4 hidden sm:block lg:-right-12">
        <NoticeCard class="animate-float" />
      </div>
    </div>

    <!-- One glass strip over the backdrop, four cells split by hairlines (the gap shows the line). -->
    <dl class="reveal mx-auto mt-20 grid max-w-5xl grid-cols-1 gap-px overflow-hidden rounded-panel bg-line shadow-card ring-glass sm:grid-cols-2 lg:grid-cols-4">
      {highlights.map((item) => (
        <div class="group flex items-start gap-4 bg-surface/80 p-6 backdrop-blur lg:flex-col lg:gap-5 lg:p-7">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-soft text-brand-strong transition-transform duration-300 ease-out group-hover:-translate-y-0.5 motion-reduce:group-hover:translate-y-0">
            <Icon name={item.icon} class="size-5.5" />
          </span>
          <div class="flex flex-col gap-1">
            <dt class="order-2 text-sm leading-relaxed text-muted">{item.label}</dt>
            <dd class="order-1 text-lg font-semibold tracking-[-0.02em] text-ink">{item.value}</dd>
          </div>
        </div>
      ))}
    </dl>
  </Container>
</section>
