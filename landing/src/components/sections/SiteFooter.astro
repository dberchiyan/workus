---
import Container from '@/components/ui/Container.astro';
import Logo from '@/components/ui/Logo.astro';
import { LANDING } from '@/content/landing';
import { SITE } from '@/content/site';

const { footer, nav } = LANDING;
const year = new Date().getUTCFullYear();
const ACCOUNT_LINKS = [
  { href: SITE.links.signIn, label: 'Sign in' },
  { href: SITE.links.signUp, label: LANDING.hero.secondary },
  { href: '#demo', label: LANDING.hero.primary },
] as const;
const RESOURCE_LINKS = [
  { href: SITE.links.github, label: footer.github },
  { href: SITE.links.readme, label: footer.readme },
  { href: SITE.links.issues, label: footer.issues },
] as const;
const COLUMNS = [
  { id: 'footer-product', title: footer.product, links: nav },
  { id: 'footer-account', title: footer.account, links: ACCOUNT_LINKS },
  { id: 'footer-resources', title: footer.resources, links: RESOURCE_LINKS },
] as const;
---

<footer class="border-t border-line py-14">
  <Container class="grid gap-10 grid-cols-2 sm:grid-cols-[2fr_1fr_1fr_1fr]">
    <div class="col-span-2 flex flex-col gap-3 sm:col-span-1">
      <Logo />
      <p class="max-w-xs text-sm text-muted">{footer.tagline}</p>
    </div>
    {COLUMNS.map((column) => (
      <nav aria-labelledby={column.id}>
        <h2 id={column.id} class="text-sm font-semibold text-ink">
          {column.title}
        </h2>
        <ul class="mt-3 flex flex-col gap-1">
          {column.links.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-9 items-center text-sm text-muted hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </Container>
  <Container class="mt-12 border-t border-line pt-6">
    <p class="text-xs text-subtle">
      © {year} {SITE.name}. {footer.rights}
    </p>
  </Container>
</footer>
