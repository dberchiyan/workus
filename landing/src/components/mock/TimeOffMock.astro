---
const BALANCES = [
  { label: 'Vacation days', used: 4, total: 10, bar: 'bg-chart-1' },
  { label: 'Sick days', used: 1, total: 5, bar: 'bg-chart-3' },
] as const;
---

<div class="flex flex-col gap-2.5">
  {BALANCES.map((balance, index) => (
    <div class="rounded-xl border border-line bg-surface p-3.5 shadow-card">
      <div class="flex items-baseline justify-between">
        <p class="text-[0.8125rem] font-medium text-ink">{balance.label}</p>
        <p class="text-[0.75rem] text-muted tabular-nums">
          <span class="font-semibold text-ink">{balance.total - balance.used}</span> of{' '}
          {balance.total} left
        </p>
      </div>
      <div class="mt-2.5 h-1.5 overflow-hidden rounded-full bg-surface-2">
        <div
          class:list={['anim-grow-x h-full rounded-full', balance.bar]}
          style={`width: ${((balance.total - balance.used) / balance.total) * 100}%; --i: ${index * 3 + 2}`}
        />
      </div>
    </div>
  ))}
</div>
