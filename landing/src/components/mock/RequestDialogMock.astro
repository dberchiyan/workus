---
import Avatar from '@/components/ui/Avatar.astro';
import MuiIcon from '@/components/ui/MuiIcon.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import { TYPES } from './timeOffTypes';

/**
 * The app's request dialog, drawn as it is: who asks, what for, the balance, the note, who
 * decides; the history and comments beside; Cancel request, Reject and Approve below. Opened and
 * closed by the hero scene (global.css → "Hero scene"); hidden otherwise.
 */
const vacation = TYPES.vacation;
---

<div class="scene-dialog pointer-events-none absolute inset-0 z-20 grid grid-cols-[minmax(0,1fr)] place-items-center p-3">
  <div class="scene-backdrop absolute inset-0 bg-navy/45"></div>
  <div class="scene-sheet relative flex w-[37rem] max-w-full min-w-0 flex-col overflow-hidden rounded-xl bg-surface shadow-float ring-glass">
    <div class="flex items-center gap-2.5 border-b border-line px-4 py-2.5">
      <Avatar name="James Okafor" size="md" />
      <div class="min-w-0 flex-1">
        <p class="truncate text-[0.8125rem] font-semibold text-ink">James Okafor’s request</p>
        <p class="truncate text-[0.625rem] text-brand">Backend Developer · Open profile</p>
      </div>
      <StatusBadge tone="warning" label="Pending" />
      <span class="text-subtle">
        <MuiIcon name="close" class="size-4" />
      </span>
    </div>

    <div class="grid gap-4 px-4 py-3 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2.5">
          <span
            class:list={[
              'flex size-8 shrink-0 items-center justify-center rounded-md text-white',
              vacation.tone,
            ]}
          >
            <MuiIcon name={vacation.icon} class="size-4.5" />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-ink">Vacation</p>
            <p class="text-[0.6875rem] text-muted tabular-nums">Nov 16 – 19, 2026</p>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-x-3 gap-y-2">
          <div class="min-w-0">
            <dt class="text-[0.5625rem] text-subtle">Working days</dt>
            <dd class="truncate text-[0.625rem] font-medium whitespace-nowrap text-ink tabular-nums">
              4 working days
            </dd>
          </div>
          <div class="min-w-0">
            <dt class="text-[0.5625rem] text-subtle">Sent</dt>
            <dd class="truncate text-[0.625rem] font-medium whitespace-nowrap text-ink tabular-nums">
              Nov 16, 2026, 5:00 AM
            </dd>
          </div>
          <div class="min-w-0">
            <dt class="text-[0.5625rem] text-subtle">Available in the cycle</dt>
            <dd class="truncate text-[0.625rem] font-medium whitespace-nowrap text-ink tabular-nums">
              3 of 10 days
            </dd>
          </div>
          <div class="min-w-0">
            <dt class="text-[0.5625rem] text-subtle">Used in the cycle</dt>
            <dd class="truncate text-[0.625rem] font-medium whitespace-nowrap text-ink tabular-nums">
              3 days
            </dd>
          </div>
        </dl>
        <div>
          <p class="text-[0.5rem] font-semibold tracking-[0.08em] text-muted uppercase">
            Employee’s note
          </p>
          <p class="mt-1 rounded-md border-l-2 border-brand bg-surface-2 px-2.5 py-1.5 text-[0.6875rem] text-ink-2">
            Wedding abroad
          </p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-[0.5rem] font-semibold tracking-[0.08em] text-muted uppercase">
            Responsible
          </p>
          <span class="flex items-center gap-1 text-[0.625rem] font-semibold text-brand">
            <MuiIcon name="edit" class="size-3" />
            Change
          </span>
        </div>
        <div class="flex items-center gap-2">
          <Avatar name="Marcus Reid" size="sm" />
          <div class="min-w-0 flex-1">
            <p class="text-[0.6875rem] font-medium text-ink">Marcus Reid</p>
            <p class="text-[0.5625rem] text-subtle">Administrator</p>
          </div>
          <span class="rounded-full bg-brand-soft px-1.5 text-[0.5625rem] font-medium text-brand-strong">
            You
          </span>
        </div>
      </div>

      <div class="hidden flex-col gap-2.5 border-l border-line pl-4 md:flex">
        <p class="text-[0.5rem] font-semibold tracking-[0.08em] text-muted uppercase">
          History and comments
        </p>
        <p class="flex items-center gap-2 text-[0.6875rem] text-ink-2">
          <span class="size-1.5 rounded-full bg-brand"></span>
          James Okafor sent the request
          <span class="ml-auto text-[0.5625rem] text-subtle tabular-nums">
            Nov 16, 2026, 5:00 AM
          </span>
        </p>
        <div class="flex items-start gap-2">
          <Avatar name="Olivia Bennett" size="xs" />
          <div class="min-w-0 flex-1 rounded-md bg-surface-2 px-2.5 py-1.5">
            <p class="flex items-center gap-2 text-[0.625rem]">
              <span class="font-semibold text-ink">Olivia Bennett</span>
              <span class="ml-auto text-[0.5625rem] text-subtle tabular-nums">
                Nov 16, 2026, 5:54 AM
              </span>
            </p>
            <p class="text-[0.6875rem] leading-snug text-ink-2">
              Checked the team calendar — no overlap with the release week.
            </p>
          </div>
        </div>
        <span class="h-12 rounded-md border border-line-strong px-2.5 py-1.5 text-[0.6875rem] text-subtle">
          Comment
        </span>
        <p class="text-[0.5625rem] text-subtle">
          Every admin and the employee will see it · Ctrl + Enter to send
        </p>
        <span class="flex items-center gap-1.5 self-end rounded-md border border-brand px-2.5 py-1 text-[0.6875rem] font-semibold text-brand">
          <MuiIcon name="send" class="size-3.5" />
          Send
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2 border-t border-line px-4 py-2.5">
      <span class="mr-auto px-1 text-[0.6875rem] font-semibold text-danger-fg">Cancel request</span>
      <span class="rounded-md px-3 py-1.5 text-[0.6875rem] font-semibold text-danger-fg ring-1 ring-danger-dot/50">
        Reject
      </span>
      <span class="scene-approve rounded-md bg-brand px-3.5 py-1.5 text-[0.6875rem] font-semibold text-on-brand shadow-card">
        Approve
      </span>
    </div>
  </div>
</div>
