# Database config
DATABASE_NAME=workus
DATABASE_USERNAME=workus
DATABASE_PASSWORD=
DATABASE_PORT=5433

# App config
APP_PORT=8080

# Environment: false = local (no limits); true = the public demo's restrictions.
DEMO_MODE=false
# Showcase accounts that cannot be edited or terminated in demo mode (comma-separated).
DEMO_PROTECTED_EMAILS=sophia.carter@osdb.io,marcus.reid@osdb.io,ava.thompson@osdb.io,liam.foster@vortex.io,hannah.brooks@vortex.io,ethan.cole@vortex.io,admin@workus.io

# Billing: `fake` (no Stripe account) or `stripe` with the test-mode values below
# (backend/.env.example explains them; `npm run stripe:setup` in backend/ creates the prices).
BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_PORTAL_CONFIGURATION=
