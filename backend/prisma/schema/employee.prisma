/// A department of the organisation's structure (Settings → Company structure); holds positions.
model PositionCategory {
  id             String       @id(map: "pk_position_categories") @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "fk_position_categories_organisation_id")
  name           String       @db.VarChar(100)
  sortOrder      Int          @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  version        Int          @default(0)
  positions      Position[]

  @@unique([organisationId, name], map: "uq_position_categories_organisation_id_name")
  @@unique([organisationId, id], map: "uq_position_categories_organisation_id_id")
  @@map("position_categories")
}

/// A position (job title) in one department of the organisation.
model Position {
  id             String           @id(map: "pk_positions") @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "fk_positions_organisation_id")
  categoryId     String           @map("category_id") @db.Uuid
  category       PositionCategory @relation(fields: [organisationId, categoryId], references: [organisationId, id], onDelete: Restrict, map: "fk_positions_category_id")
  title          String           @db.VarChar(150)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  version        Int              @default(0)
  employees      Employee[]

  /// Unique across the organisation, so the position picker is never ambiguous.
  @@unique([organisationId, title], map: "uq_positions_organisation_id_title")
  @@unique([organisationId, id], map: "uq_positions_organisation_id_id")
  @@index([organisationId, categoryId], map: "idx_positions_organisation_id_category_id")
  @@map("positions")
}

/// HR record of a user with the EMPLOYEE (or MANAGER) role; admins have none.
model Employee {
  id                 String                @id(map: "pk_employees") @default(dbgenerated("uuidv7()")) @db.Uuid
  organisationId     String                @map("organisation_id") @db.Uuid
  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "fk_employees_organisation_id")
  userId             String                @map("user_id") @db.Uuid
  user               User                  @relation("EmployeeUser", fields: [organisationId, userId], references: [organisationId, id], onDelete: Restrict, map: "fk_employees_user_id")
  positionId         String                @map("position_id") @db.Uuid
  position           Position              @relation(fields: [organisationId, positionId], references: [organisationId, id], onDelete: Restrict, map: "fk_employees_position_id")
  startDate          DateTime              @map("start_date") @db.Date
  terminatedOn       DateTime?             @map("terminated_on") @db.Date // set → terminated from that day
  /// Set together with terminated_on: RESIGNATION | DISMISSAL | END_OF_CONTRACT | LAYOFF | OTHER — CHECK in migration.
  terminationReason  String?               @map("termination_reason") @db.VarChar(32)
  /// Optional note; required for OTHER — CHECK.
  terminationComment String?               @map("termination_comment") @db.VarChar(500)
  mobile             String?               @db.VarChar(32)
  personalEmail      String?               @map("personal_email") @db.VarChar(254)
  linkedinUrl        String?               @map("linkedin_url") @db.VarChar(255)
  telegram           String?               @db.VarChar(33) // "@handle"
  address            String?               @db.VarChar(500)
  /// Optional; on or after 1900-01-01 — CHECK in migration. Personal data: the audit log records only that it changed.
  dateOfBirth        DateTime?             @map("date_of_birth") @db.Date
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?               @map("created_by") @db.Uuid
  updatedBy          String?               @map("updated_by") @db.Uuid
  version            Int                   @default(0)
  responsibles       EmployeeResponsible[]
  employeeReviews    EmployeeReview[]
  auditEvents        AuditEvent[]
  timeOffRequests    TimeOffRequest[]

  /// One HR record per user (a user belongs to one organisation, so this is also unique by user).
  @@unique([organisationId, userId], map: "uq_employees_organisation_id_user_id")
  @@unique([organisationId, id], map: "uq_employees_organisation_id_id")
  @@index([organisationId, positionId], map: "idx_employees_organisation_id_position_id")
  @@index([startDate], map: "idx_employees_start_date")
  @@index([terminatedOn], map: "idx_employees_terminated_on")
  @@map("employees")
}

/// People responsible for an employee (any user, e.g. an admin or a project manager).
model EmployeeResponsible {
  organisationId    String       @map("organisation_id") @db.Uuid
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "fk_employee_responsibles_organisation_id")
  employeeId        String       @map("employee_id") @db.Uuid
  // The assignment means nothing without the employee.
  employee          Employee     @relation(fields: [organisationId, employeeId], references: [organisationId, id], onDelete: Cascade, map: "fk_employee_responsibles_employee_id")
  responsibleUserId String       @map("responsible_user_id") @db.Uuid
  responsible       User         @relation("EmployeeResponsibleUser", fields: [organisationId, responsibleUserId], references: [organisationId, id], onDelete: Restrict, map: "fk_employee_responsibles_responsible_user_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?      @map("created_by") @db.Uuid

  @@id([employeeId, responsibleUserId], map: "pk_employee_responsibles")
  @@index([responsibleUserId], map: "idx_employee_responsibles_responsible_user_id")
  @@index([organisationId], map: "idx_employee_responsibles_organisation_id")
  @@map("employee_responsibles")
}
