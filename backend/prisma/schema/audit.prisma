/// Append-only history of changes made in the app (data.md → Audit log). No UPDATE/DELETE:
/// a trigger rejects both. Targets are referenced by type + id without a FK — a deleted review
/// keeps its history.
model AuditEvent {
  id             String       @id(map: "pk_audit_events") @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, map: "fk_audit_events_organisation_id")

  action      String    @db.VarChar(64)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actor       User?     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "fk_audit_events_actor_user_id")
  employeeId  String?   @map("employee_id") @db.Uuid
  employee    Employee? @relation(fields: [organisationId, employeeId], references: [organisationId, id], onDelete: Restrict, map: "fk_audit_events_employee_id")
  targetType  String    @map("target_type") @db.VarChar(32)
  targetId    String    @map("target_id") @db.Uuid
  targetLabel String    @map("target_label") @db.VarChar(255)
  changes     Json      @db.JsonB
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  traceId     String?   @map("trace_id") @db.VarChar(64)

  @@index([employeeId, occurredAt], map: "idx_audit_events_employee_id_occurred_at")
  @@index([actorUserId], map: "idx_audit_events_actor_user_id")
  @@index([organisationId, occurredAt], map: "idx_audit_events_organisation_id_occurred_at")
  @@index([targetId, occurredAt], map: "idx_audit_events_target_id_occurred_at")
  @@map("audit_events")
}
