model Session {
  id                String   @id(map: "pk_sessions") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  // Sessions belong to their user and have no meaning without it.
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_sessions_user_id")
  tokenHash         String   @map("token_hash") @db.Char(64) // SHA-256 hex of the session token
  csrfTokenHash     String   @map("csrf_token_hash") @db.Char(64) // SHA-256 hex of the CSRF token
  authorities       String[] @db.VarChar(32) // snapshot of the user's role at login
  clientType        String   @map("client_type") @db.VarChar(16) // web | mobile — CHECK in migration
  ip                String?  @db.VarChar(45)
  userAgent         String?  @map("user_agent") @db.VarChar(512)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)

  @@unique([tokenHash], map: "uq_sessions_token_hash")
  @@index([userId], map: "idx_sessions_user_id")
  @@index([absoluteExpiresAt], map: "idx_sessions_absolute_expires_at")
  @@index([idleExpiresAt], map: "idx_sessions_idle_expires_at")
  @@map("sessions")
}
