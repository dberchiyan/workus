/// A performance/salary review of an employee. Salary = new monthly salary agreed in the review.
model EmployeeReview {
  id             String                      @id(map: "pk_employee_reviews") @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId     String                      @map("employee_id") @db.Uuid
  employee       Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict, map: "fk_employee_reviews_employee_id")
  /// STARTING = the salary agreed at hire (one per employee, dated the start date, always COMPLETED); REGULAR otherwise.
  kind           String                      @default("REGULAR") @db.VarChar(16) // STARTING | REGULAR — CHECK in migration
  title          String                      @db.VarChar(150)
  reviewDate     DateTime                    @map("review_date") @db.Date
  status         String                      @db.VarChar(32) // COMPLETED | SCHEDULED | CANCELED — CHECK in migration
  salaryAmount   Decimal?                    @map("salary_amount") @db.Decimal(19, 4) // required when COMPLETED — CHECK
  salaryCurrency String?                     @map("salary_currency") @db.Char(3) // set together with the amount — CHECK
  /// Rich-text feedback (TipTap document JSON, whitelisted nodes/marks; ≤ 2000 characters of text).
  feedbackHr     Json?                       @map("feedback_hr") @db.JsonB
  feedbackLead   Json?                       @map("feedback_lead") @db.JsonB
  feedbackTeam   Json?                       @map("feedback_team") @db.JsonB
  feedbackClient Json?                       @map("feedback_client") @db.JsonB
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String?                     @map("created_by") @db.Uuid
  updatedBy      String?                     @map("updated_by") @db.Uuid
  version        Int                         @default(0)
  responsibles   EmployeeReviewResponsible[]

  @@index([employeeId, reviewDate], map: "idx_employee_reviews_employee_id_review_date")
  @@map("employee_reviews")
}

model EmployeeReviewResponsible {
  reviewId          String         @map("review_id") @db.Uuid
  // The assignment means nothing without the review.
  review            EmployeeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_employee_review_responsibles_review_id")
  responsibleUserId String         @map("responsible_user_id") @db.Uuid
  responsible       User           @relation("ReviewResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict, map: "fk_employee_review_responsibles_responsible_user_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?        @map("created_by") @db.Uuid

  @@id([reviewId, responsibleUserId], map: "pk_employee_review_responsibles")
  @@index([responsibleUserId], map: "idx_employee_review_responsibles_responsible_user_id")
  @@map("employee_review_responsibles")
}
