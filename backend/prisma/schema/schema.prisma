generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model RateLimit {
  key    String  @id(map: "pk_rate_limits") @db.VarChar(255)
  points Int     @default(0)
  expire BigInt?

  @@map("rate_limits")
}
