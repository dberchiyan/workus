/// The tenant: a company with its own people and data. Every user belongs to exactly one
/// organisation; every tenant-owned row carries `organisation_id`. Child rows reference their
/// parents by (organisation_id, id), so rows of two organisations can never be linked.
model Organisation {
  id                         String                      @id(map: "pk_organisations") @default(dbgenerated("uuidv7()")) @db.Uuid
  name                       String                      @db.VarChar(100)
  status                     String                      @db.VarChar(16)
  isPlatform                 Boolean                     @default(false) @map("is_platform")
  decidedAt                  DateTime?                   @map("decided_at") @db.Timestamptz(3)
  decidedBy                  String?                     @map("decided_by") @db.Uuid
  decider                    User?                       @relation("OrganisationDecider", fields: [decidedBy], references: [id], onDelete: Restrict, map: "fk_organisations_decided_by")
  rejectionReason            String?                     @map("rejection_reason") @db.VarChar(500)
  plan                       String                      @default("STARTER") @db.VarChar(16)
  subscriptionStatus         String                      @default("NONE") @map("subscription_status") @db.VarChar(16)
  scheduledPlan              String?                     @map("scheduled_plan") @db.VarChar(16)
  periodEndsAt           DateTime?                   @map("period_ends_at") @db.Timestamptz(3)
  pastDueAt               DateTime?                   @map("past_due_at") @db.Timestamptz(3)
  billingCustomerId          String?                     @unique(map: "uq_organisations_billing_customer_id") @map("billing_customer_id") @db.VarChar(64)
  billingSubscriptionId      String?                     @unique(map: "uq_organisations_billing_subscription_id") @map("billing_subscription_id") @db.VarChar(64)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                  String?                     @map("created_by") @db.Uuid
  updatedBy                  String?                     @map("updated_by") @db.Uuid
  version                    Int                         @default(0)
  users                      User[]
  employees                  Employee[]
  positionCategories         PositionCategory[]
  positions                  Position[]
  employeeResponsibles       EmployeeResponsible[]
  employeeReviews            EmployeeReview[]
  employeeReviewResponsibles EmployeeReviewResponsible[]
  timeOffRequests            TimeOffRequest[]
  timeOffRequestResponsibles TimeOffRequestResponsible[]
  timeOffRequestComments     TimeOffRequestComment[]
  companyHolidays            CompanyHoliday[]
  notifications              Notification[]
  auditEvents                AuditEvent[]
  billingEvents              BillingEvent[]

  @@index([status, createdAt], map: "idx_organisations_status_created_at")
  @@index([subscriptionStatus, pastDueAt], map: "idx_organisations_subscription_status_past_due_at")
  @@index([decidedBy], map: "idx_organisations_decided_by")
  @@map("organisations")
}
