/// A time-off request of an employee: a type, an inclusive date range and the working days it
/// takes. Decided (approved / rejected) by the employee's responsible people; the employee may
/// cancel it. Its history lives in audit_events (target_type time_off_request).
model TimeOffRequest {
  id              String                      @id(map: "pk_time_off_requests") @default(dbgenerated("uuidv7()")) @db.Uuid
  employeeId      String                      @map("employee_id") @db.Uuid
  employee        Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict, map: "fk_time_off_requests_employee_id")
  type            String                      @db.VarChar(16) // VACATION | SICK_DAY | DAY_OFF — CHECK in migration
  startDate       DateTime                    @map("start_date") @db.Date
  endDate         DateTime                    @map("end_date") @db.Date // inclusive; >= start_date — CHECK
  /// Working days (Mon–Fri, not company holidays) in the range: > 0 when made — CHECK >= 0, a
  /// holiday added later may take the last one; kept in step with holidays.
  days            Int
  status          String                      @db.VarChar(16) // PENDING | APPROVED | REJECTED | CANCELED — CHECK
  /// The employee's note.
  note            String?                     @db.VarChar(500)
  /// Why it was rejected (or a note with the approval).
  decisionComment String?                     @map("decision_comment") @db.VarChar(500)
  decidedBy       String?                     @map("decided_by") @db.Uuid
  decider         User?                       @relation("TimeOffRequestDecider", fields: [decidedBy], references: [id], onDelete: Restrict, map: "fk_time_off_requests_decided_by")
  decidedAt       DateTime?                   @map("decided_at") @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?                     @map("created_by") @db.Uuid
  updatedBy       String?                     @map("updated_by") @db.Uuid
  version         Int                         @default(0)
  responsibles    TimeOffRequestResponsible[]
  comments        TimeOffRequestComment[]

  @@index([employeeId, startDate], map: "idx_time_off_requests_employee_id_start_date")
  @@index([status, createdAt], map: "idx_time_off_requests_status_created_at")
  @@index([decidedBy], map: "idx_time_off_requests_decided_by")
  @@map("time_off_requests")
}

/// Who may decide the request: the employee's responsible people when it was made; any admin may
/// change them while it is pending.
model TimeOffRequestResponsible {
  requestId         String         @map("request_id") @db.Uuid
  // The assignment means nothing without the request.
  request           TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "fk_time_off_request_responsibles_request_id")
  responsibleUserId String         @map("responsible_user_id") @db.Uuid
  responsible       User           @relation("TimeOffRequestResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict, map: "fk_time_off_request_responsibles_responsible_user_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?        @map("created_by") @db.Uuid

  @@id([requestId, responsibleUserId], map: "pk_time_off_request_responsibles")
  @@index([responsibleUserId], map: "idx_time_off_request_responsibles_responsible_user_id")
  @@map("time_off_request_responsibles")
}

/// Comments on a request by admins and the employee; only the author edits or deletes one.
model TimeOffRequestComment {
  id        String         @id(map: "pk_time_off_request_comments") @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  request   TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, map: "fk_time_off_request_comments_request_id")
  authorId  String         @map("author_id") @db.Uuid
  author    User           @relation("TimeOffRequestCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, map: "fk_time_off_request_comments_author_id")
  body      String         @db.VarChar(1000)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when its author edits it (only the author edits or deletes a comment).
  editedAt  DateTime?      @map("edited_at") @db.Timestamptz(3)

  @@index([requestId, createdAt], map: "idx_time_off_request_comments_request_id_created_at")
  @@index([authorId], map: "idx_time_off_request_comments_author_id")
  @@map("time_off_request_comments")
}

/// A company holiday: a non-working day for everyone, so time off on it takes no working day.
/// One row per date and year. A recurring holiday is copied to the next year once (then
/// `carried_over`); each year's copy is edited on its own.
model CompanyHoliday {
  id          String   @id(map: "pk_company_holidays") @default(dbgenerated("uuidv7()")) @db.Uuid
  date        DateTime @db.Date
  name        String   @db.VarChar(100)
  /// Repeats every year: copied to the same day of the next year.
  recurring   Boolean  @default(false)
  /// Set when its copy for the next year was made (never copied twice, even if that copy is deleted).
  carriedOver Boolean  @default(false) @map("carried_over")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid
  version     Int      @default(0)

  @@unique([date], map: "uq_company_holidays_date")
  @@index([recurring, carriedOver], map: "idx_company_holidays_recurring_carried_over")
  @@map("company_holidays")
}
