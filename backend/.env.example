
APP_ENV=dev
NODE_ENV=development
PORT=3000
TZ=UTC

# Database config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=workus
DATABASE_USERNAME=workus
DATABASE_PASSWORD=
DB_POOL_SIZE=10
DB_QUERY_LOG=false
TRUST_PROXY_HOPS=0

# Session cookie configs. In production (https) use SESSION_COOKIE_NAME=__Host-workus_session
# with COOKIE_SECURE=true and an empty COOKIE_DOMAIN: the browser then refuses to let any
# subdomain set or shadow the session cookie.
SESSION_COOKIE_NAME=workus_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Sign out after this long without activity (the app warns 2 minutes before); 24 h at most.
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173
SUPPORTED_LOCALES=en

# Public demo: refuses password / role changes, ending sessions and edits of the showcase
# accounts below, so one visitor cannot lock the others out. Off for local development.
DEMO_MODE=false
DEMO_PROTECTED_EMAILS=sophia.carter@osdb.io,marcus.reid@osdb.io,ava.thompson@osdb.io,liam.foster@vortex.io,hannah.brooks@vortex.io,ethan.cole@vortex.io,admin@workus.io

SHADOW_DATABASE_URL=
